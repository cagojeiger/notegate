NOTEGATE_DATABASE_URL=postgres://notegate:notegate@localhost:5433/notegate
NOTEGATE_DB_MAX_CONNECTIONS=10
# Optional read endpoint used by locally hosted search. Leave unset to share the primary pool.
# NOTEGATE_READ_DATABASE_URL=postgres://notegate:notegate@localhost:5433/notegate
NOTEGATE_READ_DB_MAX_CONNECTIONS=10
# all: every role, api: API + local/remote search client, worker: queue consumer,
# reconciler: scheduled convergence, search: private search HTTP only
NOTEGATE_PROCESS_MODE=all
# Private search listener. Keep loopback unless this process is a dedicated search pod.
NOTEGATE_SEARCH_BIND_ADDR=127.0.0.1:9192
# Set on API pods only when search runs as a separate service.
# NOTEGATE_SEARCH_SERVICE_URL=http://notegate-search:9192
POSTGRES_PORT=5433
NOTEGATE_AUTHGATE_URL=https://authgate.project-jelly.io
NOTEGATE_PUBLIC_URL=http://localhost:9191
NOTEGATE_OAUTH_CLIENT_ID=notegate-web
NOTEGATE_MCP_OAUTH_CLIENT_ID=notegate-mcp
# Per-process safety limits, not user tier quotas. Ingress is shared; V1, V2, User MCP, and Agent MCP use independent buckets.
NOTEGATE_HTTP_RATE_LIMITS__INGRESS__REQUESTS_PER_SECOND=500
NOTEGATE_HTTP_RATE_LIMITS__INGRESS__BURST=750
NOTEGATE_HTTP_RATE_LIMITS__BROWSER_V1__REQUESTS_PER_SECOND=300
NOTEGATE_HTTP_RATE_LIMITS__BROWSER_V1__BURST=450
NOTEGATE_HTTP_RATE_LIMITS__PUBLIC_V2__REQUESTS_PER_SECOND=300
NOTEGATE_HTTP_RATE_LIMITS__PUBLIC_V2__BURST=450
NOTEGATE_HTTP_RATE_LIMITS__MCP__REQUESTS_PER_SECOND=300
NOTEGATE_HTTP_RATE_LIMITS__MCP__BURST=450
NOTEGATE_HTTP_RATE_LIMITS__MCP_V2__REQUESTS_PER_SECOND=300
NOTEGATE_HTTP_RATE_LIMITS__MCP_V2__BURST=450
NOTEGATE_ENC_ROOT_KEY_ID=dev-enc
NOTEGATE_ENC_ROOT_SECRET=replace-with-distinct-enc-root-secret-32b
NOTEGATE_LOOKUP_ROOT_KEY_ID=dev-lookup
NOTEGATE_LOOKUP_ROOT_SECRET=replace-with-distinct-lookup-root-secret-32b

# Process-local decrypted body cache for grep. Set max capacity to 0 to disable.
NOTEGATE_SEARCH_BODY_CACHE__MAX_CAPACITY_BYTES=134217728
NOTEGATE_SEARCH_BODY_CACHE__TTL_SECS=1800
NOTEGATE_SEARCH_BODY_CACHE__TTI_SECS=300

# Prometheus RED metrics. Disabled by default; expose /metrics only on trusted networks.
NOTEGATE_METRICS_ENABLED=false
# In-process background handlers. Keep at least concurrency + 2 DB connections.
NOTEGATE_BACKGROUND_JOBS__CONCURRENCY=4
# The production-like Docker Compose stack bundles Prometheus and enables metrics.
COMPOSE_NOTEGATE_METRICS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=notegate-local

# The bucket must already exist; Notegate never creates it.
# Docker Compose's minio-init service provisions this development bucket.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9191,http://127.0.0.1:9191
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=minio-root-secret
NOTEGATE_S3__ENDPOINT=http://localhost:9000
NOTEGATE_S3__PUBLIC_ENDPOINT=http://localhost:9000
NOTEGATE_S3__REGION=us-east-1
NOTEGATE_S3__BUCKET=notegate
NOTEGATE_S3__ACCESS_KEY=notegate-app
NOTEGATE_S3__SECRET_KEY=notegate-app-secret
NOTEGATE_S3__FORCE_PATH_STYLE=true

LOG_FORMAT=
RUST_LOG=notegate_api=info,notegate_jobs=info,notegate_db=info,tower_http=info

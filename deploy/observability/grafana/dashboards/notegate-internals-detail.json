      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3,
          "mappings": [
            {
              "options": {
                "match": "null",
                "result": {
                  "color": "gray",
                  "text": "No acquires"
                }
              },
              "type": "special"
            }

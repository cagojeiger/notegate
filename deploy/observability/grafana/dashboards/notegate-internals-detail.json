      "description": "Meaning: share of configured DB connections currently checked out. High utilization alone can be normal under load; sustained near-capacity usage with rising acquire latency or timeouts indicates pool or database saturation. Check request rate and slow-query evidence before resizing the pool.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [

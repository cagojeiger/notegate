      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(notegate_mcp_tool_duration_seconds_bucket{job=\"notegate\", instance=~\"$instance\", tool=~\"$tool\"}[$__rate_interval])))",
          "instant": false,

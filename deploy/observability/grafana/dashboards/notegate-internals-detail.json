      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(notegate_db_pool_acquire_timeouts_total{job=\"notegate\", instance=~\"$instance\"}[$__rate_interval])) or vector(0)",
          "instant": false,
          "legendFormat": "timeouts",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "DB Acquire Timeouts",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Meaning: share of configured DB connections currently checked out. High utilization alone can be normal under load; sustained near-capacity usage with rising acquire latency or timeouts indicates pool or database saturation. Check request rate and slow-query evidence before resizing the pool.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "id": 10,

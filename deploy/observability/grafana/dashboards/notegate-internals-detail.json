          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(notegate_db_pool_connections{job=\"notegate\", instance=~\"$instance\", state=\"in_use\"}) / clamp_min(sum(notegate_db_pool_max_connections{job=\"notegate\", instance=~\"$instance\"}), 1)",
          "instant": false,
          "legendFormat": "pool utilization",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "DB Pool Utilization",
      "type": "stat"
    },
    {
